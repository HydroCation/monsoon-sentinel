 111:Core/Src/main.c ****   //Wake up the MPU
 112:Core/Src/main.c ****   uint8_t wakeup_val = 0x00;
 113:Core/Src/main.c ****   HAL_StatusTypeDef wake_status = HAL_I2C_Mem_Write(&hi2c1, MPU6050_ADDR, PWR_MGMT_1_REG, I2C_MEMAD
 114:Core/Src/main.c ****   if (wake_status == HAL_OK){
 115:Core/Src/main.c ****     //Light up solid for OK wakeup
 116:Core/Src/main.c ****     HAL_GPIO_WritePin(LD2_GPIO_Port, LD2_Pin, GPIO_PIN_SET);
 117:Core/Src/main.c ****   } else {
 118:Core/Src/main.c ****     //Blink rapidly on failure
 119:Core/Src/main.c ****     while(1){
 120:Core/Src/main.c ****       HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin);
 121:Core/Src/main.c ****       HAL_Delay(100);
 122:Core/Src/main.c ****     }
 123:Core/Src/main.c ****   }
 124:Core/Src/main.c ****   
 125:Core/Src/main.c ****   /* USER CODE END 2 */
 126:Core/Src/main.c **** 
 127:Core/Src/main.c ****   /* Infinite loop */
 128:Core/Src/main.c ****   /* USER CODE BEGIN WHILE */
 129:Core/Src/main.c ****   while (1)
 130:Core/Src/main.c ****   {
 131:Core/Src/main.c **** 
 132:Core/Src/main.c ****     //Read all 14 bytes of sensor data per 'stream'
 133:Core/Src/main.c ****     HAL_I2C_Mem_Read(&hi2c1, MPU6050_ADDR, ACCEL_XOUT_H_REG, I2C_MEMADD_SIZE_8BIT, sensor_data, 14,
 134:Core/Src/main.c **** 
 135:Core/Src/main.c ****     //Reconstruct the 16 bit signed values
 136:Core/Src/main.c ****     Accel_X_RAW = (int16_t)((sensor_data[0]<<8)|sensor_data[1]);
 137:Core/Src/main.c ****     Accel_Y_RAW = (int16_t)((sensor_data[2]<<8)|sensor_data[3]);
 138:Core/Src/main.c ****     Accel_Z_RAW = (int16_t)((sensor_data[4]<<8)|sensor_data[5]);
 139:Core/Src/main.c **** 
 140:Core/Src/main.c ****     Gyro_X_RAW = (int16_t)((sensor_data[8]<<8)|sensor_data[9]);
 141:Core/Src/main.c ****     Gyro_Y_RAW = (int16_t)((sensor_data[10]<<8)|sensor_data[11]);
 142:Core/Src/main.c ****     Gyro_Z_RAW = (int16_t)((sensor_data[12]<<8)|sensor_data[13]);
 143:Core/Src/main.c **** 
 144:Core/Src/main.c ****     //Format as CSV
 145:Core/Src/main.c ****     int len = sprintf(uart_buf, "%d,%d,%d,%d,%d,%d\r\n",Accel_X_RAW, Accel_Y_RAW, Accel_Z_RAW, Gyro
ARM GAS  /tmp/ccaHNTjV.s 			page 4


 146:Core/Src/main.c **** 
 147:Core/Src/main.c ****     //Send CSV over UART2
 148:Core/Src/main.c ****     HAL_UART_Transmit(&huart2, (uint8_t*)uart_buf, len, 100);
 149:Core/Src/main.c **** 
 150:Core/Src/main.c ****     //Sample at 10 Hz
 151:Core/Src/main.c ****     HAL_Delay(100);
 152:Core/Src/main.c **** 
 153:Core/Src/main.c ****     /* USER CODE END WHILE */
 154:Core/Src/main.c **** 
 155:Core/Src/main.c ****     /* USER CODE BEGIN 3 */
 156:Core/Src/main.c ****   }
